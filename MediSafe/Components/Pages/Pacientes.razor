@page "/pacientes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Medico")]

@using MediSafe.Data
@using MediSafe.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Mis pacientes - MediSafe</PageTitle>

<div class="container mt-4">
    <h1>Mis pacientes</h1>
    <p class="text-muted">
        Médico responsable: <strong>@NombreMedico</strong>
    </p>
    <p class="text-muted">
        Los campos marcados con (*) son obligatorios.
    </p>
    <div class="d-flex gap-2">
        <a href="/medico" class="btn btn-outline-primary">
            Volver al panel
        </a>
	</div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @ClaseMensaje">
            @Mensaje
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4>Registrar paciente</h4>

            <EditForm Model="NuevoPaciente"
                      OnValidSubmit="RegistrarPaciente"
                      FormName="RegistrarPaciente">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre *</label>
                        <InputText class="form-control"
                                   @bind-Value="NuevoPaciente.Nombre" />
                        <ValidationMessage For="@(() => NuevoPaciente.Nombre)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Apellidos *</label>
                        <InputText class="form-control"
                                   @bind-Value="NuevoPaciente.Apellidos" />
                        <ValidationMessage For="@(() => NuevoPaciente.Apellidos)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de nacimiento</label>
                        <InputDate class="form-control"
                                   @bind-Value="NuevoPaciente.FechaNacimiento" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Teléfono (opcional)</label>
                        <InputText class="form-control"
                                   @bind-Value="NuevoPaciente.Telefono"
                                   maxlength="10" />
                        <ValidationMessage For="@(() => NuevoPaciente.Telefono)" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <InputText class="form-control"
                                   @bind-Value="NuevoPaciente.Email" />
                        <ValidationMessage For="@(() => NuevoPaciente.Email)" />
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Recepcionista responsable *</label>

                    <InputSelect class="form-select"
                                 @bind-Value="RecepcionistaSeleccionadaId">

                        <option value="">Selecciona una recepcionista</option>

                        @foreach (var recepcionista in Recepcionistas)
                        {
                            <option value="@recepcionista.Id">
                                @(string.IsNullOrWhiteSpace(recepcionista.Nombre)
                                    ? recepcionista.Email
                                    : recepcionista.Nombre)
                            </option>
                        }

                    </InputSelect>
                </div>

                <button type="submit" class="btn btn-primary">
                    Registrar paciente
                </button>
            </EditForm>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4>Pacientes registrados</h4>

            @if (RegistrosPacientes.Count == 0)
            {
                <p class="text-muted">
                    Todavía no tienes pacientes registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Fecha de nacimiento</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Recepcionista</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var paciente in RegistrosPacientes)
                            {
                                <tr>
                                    <td>@paciente.Nombre @paciente.Apellidos</td>
                                    <td>
                                        @(paciente.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrada")
                                    </td>
                                    <td>@(paciente.Telefono ?? "No registrado")</td>
                                    <td>@(paciente.Email ?? "No registrado")</td>
                                    <td>
                                        @(paciente.Recepcionista?.Nombre
                                            ?? paciente.Recepcionista?.Email
                                            ?? "Sin recepcionista asignada")
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                @onclick="() => IniciarEdicion(paciente)">
                                            Editar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    @if (PacienteEditando != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4>Editar paciente</h4>

                <EditForm Model="DatosEdicion"
                          OnValidSubmit="GuardarEdicion"
                          FormName="EditarPaciente">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control"
                                       @bind-Value="DatosEdicion.Nombre" />
                            <ValidationMessage For="@(() => DatosEdicion.Nombre)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos *</label>
                            <InputText class="form-control"
                                       @bind-Value="DatosEdicion.Apellidos" />
                            <ValidationMessage For="@(() => DatosEdicion.Apellidos)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fecha de nacimiento</label>
                            <InputDate class="form-control"
                                       @bind-Value="DatosEdicion.FechaNacimiento" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono (opcional)</label>
                            <InputText class="form-control"
                                       @bind-Value="DatosEdicion.Telefono"
                                       maxlength="10"
                                       inputmode="numeric" />
                            <ValidationMessage For="@(() => DatosEdicion.Telefono)" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <InputText class="form-control"
                                       @bind-Value="DatosEdicion.Email" />
                            <ValidationMessage For="@(() => DatosEdicion.Email)" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success me-2">
                        Guardar cambios
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {

    private Paciente? PacienteEditando;
    private CrearPacienteModel DatosEdicion = new();
    
    private CrearPacienteModel NuevoPaciente = new();

    private List<Paciente> RegistrosPacientes = new();

    private List<ApplicationUser> Recepcionistas = new();

    private string? RecepcionistaSeleccionadaId;

    private string Mensaje = string.Empty;
    private string ClaseMensaje = "alert-info";

    private string? MedicoId;
    private string NombreMedico = "No identificado";

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var medico = await UserManager.GetUserAsync(estado.User);

        if (medico == null)
        {
            return;
        }

        MedicoId = medico.Id;
        NombreMedico = string.IsNullOrWhiteSpace(medico.Nombre)
        ? medico.Email ?? "Médico"
        : medico.Nombre;

        Recepcionistas = (await UserManager.GetUsersInRoleAsync(
            ApplicationRoles.Receptionist)).ToList();
        
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        if (string.IsNullOrEmpty(MedicoId))
        {
            return;
        }

        RegistrosPacientes = await Db.RegistrosPacientes
            .AsNoTracking()
			.Include(p => p.Recepcionista)
            .Where(p => p.MedicoId == MedicoId)
            .OrderByDescending(p => p.FechaRegistro)
            .ToListAsync();
    }


    
    private async Task RegistrarPaciente()
    {
        if (string.IsNullOrEmpty(MedicoId))
        {
            MostrarError("No se pudo identificar al médico.");
            return;
        }

        if (string.IsNullOrEmpty(RecepcionistaSeleccionadaId))
        {
            MostrarError("Debes seleccionar una recepcionista.");
            return;
        }

        var recepcionista = await UserManager.FindByIdAsync(
            RecepcionistaSeleccionadaId);

        if (recepcionista == null ||
            !await UserManager.IsInRoleAsync(
                recepcionista, ApplicationRoles.Receptionist))
        {
            MostrarError("La recepcionista seleccionada no es válida.");
            return;
        }

        try
        {
            var paciente = new Paciente
            {
                Nombre = NuevoPaciente.Nombre.Trim(),
                Apellidos = NuevoPaciente.Apellidos.Trim(),
                FechaNacimiento = NuevoPaciente.FechaNacimiento,
                Telefono = NuevoPaciente.Telefono,
                Email = NuevoPaciente.Email,
                MedicoId = MedicoId,
                RecepcionistaId = recepcionista.Id,
                FechaRegistro = DateTime.UtcNow
            };

            Db.RegistrosPacientes.Add(paciente);

            await Db.SaveChangesAsync();

            NuevoPaciente = new CrearPacienteModel();
            RecepcionistaSeleccionadaId = null;

            await CargarPacientes();

            Mensaje = "El paciente se registró correctamente.";
            ClaseMensaje = "alert-success";
        }
        catch (ContenidoNoPermitidoException)
        {
            var entrada = Db.ChangeTracker.Entries<Paciente>()
                .FirstOrDefault(e => e.State == EntityState.Added);

            if (entrada != null)
            {
                entrada.State = EntityState.Detached;
            }

            MostrarError(
                "No se permite ingresar contenido HTML o JavaScript. " +
                "Revisa los campos e intenta nuevamente.");
        }
    }


    private void MostrarError(string mensaje)
    {
        Mensaje = mensaje;
        ClaseMensaje = "alert-danger";
    }

    private void IniciarEdicion(Paciente paciente)
    {
        if (paciente.MedicoId != MedicoId)
            return;

        PacienteEditando = paciente;

        DatosEdicion = new CrearPacienteModel
        {
            Nombre = paciente.Nombre,
            Apellidos = paciente.Apellidos,
            FechaNacimiento = paciente.FechaNacimiento,
            Telefono = paciente.Telefono,
            Email = paciente.Email
        };

        Mensaje = string.Empty;
    }

   
    private async Task GuardarEdicion()
    {
        if (PacienteEditando == null || string.IsNullOrEmpty(MedicoId))
        {
            MostrarError("No se pudo identificar al paciente o al médico.");
            return;
        }

        // Verificar que el paciente pertenece al médico.
        var paciente = await Db.RegistrosPacientes
            .FirstOrDefaultAsync(p =>
                p.Id == PacienteEditando.Id &&
                p.MedicoId == MedicoId);

        if (paciente == null)
        {
            MostrarError(
                "No se encontró el paciente o no tienes permiso para editarlo.");

            PacienteEditando = null;
            return;
        }

        try
        {
            paciente.Nombre = DatosEdicion.Nombre.Trim();
            paciente.Apellidos = DatosEdicion.Apellidos.Trim();
            paciente.FechaNacimiento = DatosEdicion.FechaNacimiento;

            paciente.Telefono = string.IsNullOrWhiteSpace(DatosEdicion.Telefono)
                ? null
                : DatosEdicion.Telefono.Trim();

            paciente.Email = string.IsNullOrWhiteSpace(DatosEdicion.Email)
                ? null
                : DatosEdicion.Email.Trim();

            await Db.SaveChangesAsync();

            PacienteEditando = null;
            DatosEdicion = new CrearPacienteModel();

            await CargarPacientes();

            Mensaje = "Los datos del paciente se actualizaron correctamente.";
            ClaseMensaje = "alert-success";
        }
        catch (ContenidoNoPermitidoException)
        {
            MostrarError(
                "No se permite ingresar contenido HTML o JavaScript. " +
                "Revisa los campos e intenta nuevamente.");

            // Deshacer los cambios pendientes en el contexto.
            await Db.Entry(paciente).ReloadAsync();
        }
    }


    private void CancelarEdicion()
    {
        PacienteEditando = null;
        DatosEdicion = new CrearPacienteModel();
    }
}