@page "/login"
@using MediSafe.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms
@inject SignInManager<IdentityUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión - MediSafe</PageTitle>

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h2 class="text-center mb-2">MediSafe</h2>
            <p class="text-center text-muted mb-4">
                Acceso seguro al sistema médico
            </p>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            <EditForm Model="model" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <InputText class="form-control"
                               @bind-Value="model.Email"
                               autocomplete="username" />
                    <ValidationMessage For="@(() => model.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="model.Password"
                               autocomplete="current-password" />
                    <ValidationMessage For="@(() => model.Password)" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="model.RememberMe" />
                    <label class="form-check-label">
                        Mantener la sesión iniciada
                    </label>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Iniciar sesión
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginModel model = new();
    private string? errorMessage;

    private async Task LoginAsync()
    {
        errorMessage = null;

        var result = await SignInManager.PasswordSignInAsync(
            model.Email,
            model.Password,
            model.RememberMe,
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
        else if (result.IsLockedOut)
        {
            errorMessage =
                "La cuenta está temporalmente bloqueada. Inténtalo más tarde.";
        }
        else
        {
            errorMessage =
                "Correo o contraseña incorrectos.";
        }
    }
}

