@page "/administrador"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

<PageTitle>Panel de administración - MediSafe</PageTitle>

<div class="container mt-4">
    <h1>Panel de administración</h1>
    <p class="text-muted">
        Bienvenido a MediSafe. Desde aquí podrás administrar las cuentas de los médicos.
    </p>

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Gestión de médicos</h5>
                    <p class="card-text">
                        Crea y administra las cuentas de acceso de los médicos.
                    </p>
                    <button class="btn btn-primary" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Seguridad</h5>
                    <p class="card-text">
                        Consulta las funciones administrativas de seguridad del sistema.
                    </p>
                    <button class="btn btn-secondary" disabled>
                        Próximamente
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
