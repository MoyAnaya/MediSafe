@page "/administrador"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

@using MediSafe.Data
@using MediSafe.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<PageTitle>Panel de administración - MediSafe</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Panel de administración</h1>
            <p class="text-muted mb-0">
                Desde aquí puedes administrar las cuentas de los médicos.
            </p>
        </div>

        <form method="post" action="/logout">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-outline-danger">
                Cerrar sesión
            </button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @ClaseMensaje" role="alert">
            @Mensaje
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-3">Registrar médico</h4>

                    <EditForm Model="NuevoMedico"
                              OnValidSubmit="CrearMedico"
                              FormName="RegistrarMedico">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre completo</label>
                            <InputText class="form-control"
                                       @bind-Value="NuevoMedico.Nombre" />
                            <ValidationMessage For="@(() => NuevoMedico.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Especialidad médica</label>

                            <InputText class="form-control"
                                       maxlength="50"
                                       @bind-Value="NuevoMedico.Especialidad"
                                       placeholder="Ej. Cardiología" />

                            <ValidationMessage For="@(() => NuevoMedico.Especialidad)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <InputText type="email" class="form-control"
                                       @bind-Value="NuevoMedico.Email" />
                            <ValidationMessage For="@(() => NuevoMedico.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contraseña inicial</label>
                            <InputText type="password" class="form-control"
                                       @bind-Value="NuevoMedico.Password" />
                            <ValidationMessage For="@(() => NuevoMedico.Password)" />
                            <small class="text-muted">
                                La contraseña debe contener:
                                mínimo 8 caracteres, una letra mayúscula,
                                una letra minúscula, un número y un carácter especial
                                (por ejemplo: !, #, $, %).
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Crear cuenta médica
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-3">
                        Registrar recepcionista
                    </h4>

                    <EditForm Model="NuevoRecepcionista"
                              OnValidSubmit="CrearRecepcionista"
                              FormName="RegistrarRecepcionista">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre completo</label>

                            <InputText class="form-control"
                                       @bind-Value="NuevoRecepcionista.Nombre" />

                            <ValidationMessage For="@(() => NuevoRecepcionista.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>

                            <InputText type="email"
                                       class="form-control"
                                       @bind-Value="NuevoRecepcionista.Email" />

                            <ValidationMessage For="@(() => NuevoRecepcionista.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contraseña inicial</label>

                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="NuevoRecepcionista.Password" />

                            <ValidationMessage For="@(() => NuevoRecepcionista.Password)" />

                            <small class="text-muted">
                                Mínimo 8 caracteres, una mayúscula,
                                una minúscula, un número y un carácter especial.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-success">
                            Crear cuenta de recepción
                        </button>

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-sm mt-4 mb-5">
        <div class="card-body">
            <h4 class="card-title mb-3">Médicos registrados</h4>

            @if (Medicos.Count == 0)
            {
                <p class="text-muted">
                    Todavía no hay médicos registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo electrónico</th>
                                <th>Especialidad</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var medico in Medicos)
                            {
                                <tr>
                                    <td>@medico.Nombre</td>
                                    <td>@medico.Email</td>
                                    <td>@(medico.Especialidad ?? "Sin especialidad registrada")</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm me-2"
                                                @onclick="() => IniciarEdicion(medico)">
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => SolicitarEliminacion(medico)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm mt-4 mb-5">
        <div class="card-body">

            <h4 class="card-title mb-3">
                Recepcionistas registrados
            </h4>

            @if (Recepcionistas.Count == 0)
            {
                <p class="text-muted">
                    Todavía no hay recepcionistas registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo electrónico</th>
								<th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var recepcionista in Recepcionistas)
                            {
                                <tr>
                                    <td>@recepcionista.Nombre</td>
                                    <td>@recepcionista.Email</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm me-2"
                                                @onclick="() => IniciarEdicionRecepcionista(recepcionista)">
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => SolicitarEliminacionRecepcionista(recepcionista)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

    @if (RecepcionistaEditando != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4>Editar recepcionista</h4>

                <EditForm Model="RecepcionistaEditando"
                          OnValidSubmit="GuardarEdicionRecepcionista"
                          FormName="EditarRecepcionista">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre completo</label>
                        <InputText class="form-control"
                                   @bind-Value="RecepcionistaEditando.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <InputText type="email"
                                   class="form-control"
                                   @bind-Value="RecepcionistaEditando.Email" />
                    </div>

                    <button type="submit" class="btn btn-success me-2">
                        Guardar cambios
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelarEdicionRecepcionista">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    @if (MedicoEditando != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4>Editar médico</h4>

                <EditForm Model="MedicoEditando"
                          OnValidSubmit="GuardarEdicion"
                          FormName="EditarMedico">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre completo</label>
                        <InputText class="form-control"
                                   @bind-Value="MedicoEditando.Nombre" />
                        <ValidationMessage For="@(() => MedicoEditando.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Especialidad médica</label>

                        <InputText class="form-control"
                                   maxlength="50"
                                   @bind-Value="MedicoEditando.Especialidad"
                                   placeholder="Ej. Pediatría" />

                        <ValidationMessage For="@(() => MedicoEditando.Especialidad)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <InputText type="email" class="form-control"
                                   @bind-Value="MedicoEditando.Email" />
                        <ValidationMessage For="@(() => MedicoEditando.Email)" />
                    </div>

                    <button type="submit" class="btn btn-success me-2">
                        Guardar cambios
                    </button>

                    <button type="button" class="btn btn-secondary"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    @if (RecepcionistaPorEliminar != null)
    {
        <div class="alert alert-warning mt-3">
            @if (!ConfirmacionFinalEliminacionRecepcionista)
            {
                <h5>Primera confirmación</h5>

                <p>
                    ¿Deseas continuar con la eliminación de la cuenta de
                    <strong>@RecepcionistaPorEliminar.Nombre</strong>
                    (@RecepcionistaPorEliminar.Email)?
                </p>

                <button class="btn btn-warning me-2"
                        @onclick="MostrarConfirmacionFinalRecepcionista">
                    Continuar
                </button>

                <button class="btn btn-secondary"
                        @onclick="CancelarEliminacionRecepcionista">
                    Cancelar
                </button>
            }
            else
            {
                <h5>Segunda confirmación: eliminación de cuenta</h5>

                <p>
                    Se eliminará permanentemente la cuenta de recepción.
                    Los pacientes y las consultas existentes se conservarán.
                </p>

                <button class="btn btn-danger me-2"
                        @onclick="EliminarRecepcionista">
                    Confirmar eliminación definitiva
                </button>

                <button class="btn btn-secondary"
                        @onclick="CancelarEliminacionRecepcionista">
                    Cancelar
                </button>
            }
        </div>
    }

    @if (MedicoPorEliminar != null)
    {
        <div class="alert alert-warning mt-3">
            @if (!ConfirmacionFinalEliminacion)
            {
                <h5>Primera confirmación</h5>

                <p>
                    ¿Deseas continuar con la eliminación de la cuenta de
                    <strong>@MedicoPorEliminar.Nombre</strong>
                    (@MedicoPorEliminar.Email)?
                </p>

                <p>
                    En el siguiente paso se te informará qué información
                    se eliminará de forma permanente.
                </p>

                <button class="btn btn-warning me-2"
                        @onclick="MostrarConfirmacionFinal">
                    Continuar
                </button>

                <button class="btn btn-secondary"
                        @onclick="CancelarEliminacion">
                    Cancelar
                </button>
            }
            else
            {
                <h5>Segunda confirmación: eliminación permanente</h5>

                <p>
                    <strong>¡Advertencia!</strong> Al eliminar esta cuenta,
                    también se eliminarán todos los pacientes registrados
                    por este médico y las consultas asociadas.
                    Esta información no podrá recuperarse desde MediSafe.
                </p>

                <p>
                    Médico: <strong>@MedicoPorEliminar.Nombre</strong>
                </p>

                <button class="btn btn-danger me-2"
                        @onclick="EliminarMedico">
                    Confirmar eliminación definitiva
                </button>

                <button class="btn btn-secondary"
                        @onclick="CancelarEliminacion">
                    Cancelar
                </button>
            }
        </div>
    }
</div>

@code {
    private CrearMedicoModel NuevoMedico = new();

    private List<ApplicationUser> Medicos = new();

    private CrearMedicoModel NuevoRecepcionista = new();

    private List<ApplicationUser> Recepcionistas = new();

	private bool ConfirmacionFinalEliminacion = false;

    private ApplicationUser? MedicoEditando;
    private ApplicationUser? MedicoPorEliminar;

    private ApplicationUser? RecepcionistaEditando;
    private ApplicationUser? RecepcionistaPorEliminar;

    private bool ConfirmacionFinalEliminacionRecepcionista = false;

    private string Mensaje = string.Empty;
    private string ClaseMensaje = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await CargarMedicos();
        await CargarRecepcionistas();
    }

    private async Task CargarMedicos()
    {
        var usuariosMedicos = await UserManager.GetUsersInRoleAsync(
            ApplicationRoles.Doctor);

        Medicos = usuariosMedicos
            .OrderBy(m => m.Nombre)
            .ToList();
    }

    private async Task CargarRecepcionistas()
    {
        var usuariosRecepcion = await UserManager.GetUsersInRoleAsync(
            ApplicationRoles.Receptionist);

        Recepcionistas = usuariosRecepcion
            .OrderBy(r => r.Nombre)
            .ToList();
    }

    private async Task CrearMedico()
    {
        var email = NuevoMedico.Email.Trim();

        var existente = await UserManager.FindByEmailAsync(email);

        if (existente != null)
        {
            MostrarError("Ya existe una cuenta con ese correo electrónico.");
            return;
        }

        var medico = new ApplicationUser
        {
            UserName = email,
            Email = email,
            Nombre = NuevoMedico.Nombre.Trim(),
			Especialidad = NuevoMedico.Especialidad?.Trim(),
            EmailConfirmed = true
        };

        var resultado = await UserManager.CreateAsync(
            medico, NuevoMedico.Password);

        if (!resultado.Succeeded)
        {
            MostrarError("Error al crear el usuario: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));
            return;
        }

        var resultadoRol = await UserManager.AddToRoleAsync(
            medico, ApplicationRoles.Doctor);

        if (!resultadoRol.Succeeded)
        {
            await UserManager.DeleteAsync(medico);
            MostrarError("Error al asignar el rol: " +
                string.Join(" | ", resultadoRol.Errors.Select(e => e.Description)));
            return;
        }

        NuevoMedico = new CrearMedicoModel();
        await CargarMedicos();

        Mensaje = "La cuenta del médico se creó correctamente.";
        ClaseMensaje = "alert-success";
    }

    private async Task CrearRecepcionista()
    {
        var email = NuevoRecepcionista.Email.Trim();

        var existente = await UserManager.FindByEmailAsync(email);

        if (existente != null)
        {
            MostrarError("Ya existe una cuenta con ese correo electrónico.");
            return;
        }

        var recepcionista = new ApplicationUser
        {
            UserName = email,
            Email = email,
            Nombre = NuevoRecepcionista.Nombre.Trim(),
            EmailConfirmed = true
        };

        var resultado = await UserManager.CreateAsync(
            recepcionista, NuevoRecepcionista.Password);

        if (!resultado.Succeeded)
        {
            MostrarError("Error al crear el usuario: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));
            return;
        }

        var resultadoRol = await UserManager.AddToRoleAsync(
            recepcionista, ApplicationRoles.Receptionist);

        if (!resultadoRol.Succeeded)
        {
            await UserManager.DeleteAsync(recepcionista);

            MostrarError("Error al asignar el rol: " +
                string.Join(" | ", resultadoRol.Errors.Select(e => e.Description)));
            return;
        }

        NuevoRecepcionista = new CrearMedicoModel();

        await CargarRecepcionistas();

        Mensaje = "La cuenta de recepción se creó correctamente.";
        ClaseMensaje = "alert-success";
    }

    private void IniciarEdicion(ApplicationUser medico)
    {
        MedicoEditando = new ApplicationUser
        {
            Id = medico.Id,
            Nombre = medico.Nombre,
            Email = medico.Email,
            UserName = medico.UserName,
			Especialidad = medico.Especialidad,
            EmailConfirmed = medico.EmailConfirmed
        };

        MedicoPorEliminar = null;
        Mensaje = string.Empty;
    }

    private async Task GuardarEdicion()
    {
        if (MedicoEditando == null)
            return;

        var original = await UserManager.FindByIdAsync(MedicoEditando.Id);

        if (original == null ||
            !await UserManager.IsInRoleAsync(original, ApplicationRoles.Doctor))
        {
            MostrarError("No se encontró la cuenta médica.");
            return;
        }

        var email = MedicoEditando.Email?.Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            MostrarError("El correo electrónico es obligatorio.");
            return;
        }

        var usuarioConCorreo = await UserManager.FindByEmailAsync(email);

        if (usuarioConCorreo != null && usuarioConCorreo.Id != original.Id)
        {
            MostrarError("Ese correo ya está registrado en otra cuenta.");
            return;
        }

        original.Nombre = MedicoEditando.Nombre.Trim();
        original.Email = email;
        original.UserName = email;
		original.Especialidad = MedicoEditando.Especialidad?.Trim();
        original.NormalizedEmail = UserManager.NormalizeEmail(email);
        original.NormalizedUserName = UserManager.NormalizeName(email);

        var resultado = await UserManager.UpdateAsync(original);

        if (!resultado.Succeeded)
        {
            MostrarError("No se pudieron guardar los cambios: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));
            return;
        }

        MedicoEditando = null;
        await CargarMedicos();

        Mensaje = "Los datos del médico se actualizaron correctamente.";
        ClaseMensaje = "alert-success";
    }

    private async Task GuardarEdicionRecepcionista()
    {
        if (RecepcionistaEditando == null)
            return;

        var original = await UserManager.FindByIdAsync(
            RecepcionistaEditando.Id);

        if (original == null ||
            !await UserManager.IsInRoleAsync(
                original, ApplicationRoles.Receptionist))
        {
            MostrarError("No se encontró la cuenta de recepción.");
            return;
        }

        var email = RecepcionistaEditando.Email?.Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            MostrarError("El correo electrónico es obligatorio.");
            return;
        }

        var usuarioConCorreo = await UserManager.FindByEmailAsync(email);

        if (usuarioConCorreo != null &&
            usuarioConCorreo.Id != original.Id)
        {
            MostrarError("Ese correo ya está registrado en otra cuenta.");
            return;
        }

        original.Nombre = RecepcionistaEditando.Nombre.Trim();
        original.Email = email;
        original.UserName = email;
        original.NormalizedEmail = UserManager.NormalizeEmail(email);
        original.NormalizedUserName = UserManager.NormalizeName(email);

        var resultado = await UserManager.UpdateAsync(original);

        if (!resultado.Succeeded)
        {
            MostrarError("No se pudieron guardar los cambios: " +
                string.Join(" | ",
                    resultado.Errors.Select(e => e.Description)));
            return;
        }

        RecepcionistaEditando = null;

        await CargarRecepcionistas();

        Mensaje = "Los datos de la recepcionista se actualizaron correctamente.";
        ClaseMensaje = "alert-success";
    }

    private void IniciarEdicionRecepcionista(ApplicationUser recepcionista)
    {
        RecepcionistaEditando = new ApplicationUser
        {
            Id = recepcionista.Id,
            Nombre = recepcionista.Nombre,
            Email = recepcionista.Email,
            UserName = recepcionista.UserName,
            EmailConfirmed = recepcionista.EmailConfirmed
        };

        RecepcionistaPorEliminar = null;
        Mensaje = string.Empty;
    }

    private void CancelarEdicionRecepcionista()
    {
        RecepcionistaEditando = null;
    }

    private void SolicitarEliminacionRecepcionista(
        ApplicationUser recepcionista)
    {
        RecepcionistaPorEliminar = recepcionista;
        ConfirmacionFinalEliminacionRecepcionista = false;
        RecepcionistaEditando = null;
        Mensaje = string.Empty;
    }

    private void MostrarConfirmacionFinalRecepcionista()
    {
        if (RecepcionistaPorEliminar != null)
        {
            ConfirmacionFinalEliminacionRecepcionista = true;
        }
    }

    private void CancelarEliminacionRecepcionista()
    {
        RecepcionistaPorEliminar = null;
        ConfirmacionFinalEliminacionRecepcionista = false;
    }

    private async Task EliminarRecepcionista()
    {
        if (RecepcionistaPorEliminar == null ||
            !ConfirmacionFinalEliminacionRecepcionista)
            return;

        var recepcionista = await UserManager.FindByIdAsync(
            RecepcionistaPorEliminar.Id);

        if (recepcionista == null ||
            !await UserManager.IsInRoleAsync(
                recepcionista, ApplicationRoles.Receptionist))
        {
            MostrarError("No se encontró la cuenta de recepción.");
            CancelarEliminacionRecepcionista();
            return;
        }

        var resultado = await UserManager.DeleteAsync(recepcionista);

        if (!resultado.Succeeded)
        {
            MostrarError("No se pudo eliminar la cuenta: " +
                string.Join(" | ",
                    resultado.Errors.Select(e => e.Description)));

            CancelarEliminacionRecepcionista();
            return;
        }

        CancelarEliminacionRecepcionista();

        await CargarRecepcionistas();

        Mensaje = "La cuenta de recepción se eliminó correctamente. Los pacientes y consultas se conservaron.";
        ClaseMensaje = "alert-success";
    }

    private void CancelarEdicion()
    {
        MedicoEditando = null;
    }

    private void SolicitarEliminacion(ApplicationUser medico)
    {
        MedicoPorEliminar = medico;
        ConfirmacionFinalEliminacion = false;
        MedicoEditando = null;
        Mensaje = string.Empty;
    }

    private void MostrarConfirmacionFinal()
    {
        if (MedicoPorEliminar != null)
        {
            ConfirmacionFinalEliminacion = true;
        }
    }

    private void CancelarEliminacion()
    {
        MedicoPorEliminar = null;
        ConfirmacionFinalEliminacion = false;
    }

    private async Task EliminarMedico()
    {
        if (MedicoPorEliminar == null || !ConfirmacionFinalEliminacion)
            return;

        var medico = await UserManager.FindByIdAsync(MedicoPorEliminar.Id);

        if (medico == null ||
            !await UserManager.IsInRoleAsync(medico, ApplicationRoles.Doctor))
        {
            MostrarError("No se encontró la cuenta médica.");
            CancelarEliminacion();
            return;
        }

        await using var transaccion = await Db.Database.BeginTransactionAsync();

        try
        {
            // Buscar los pacientes registrados por este médico.
            var pacientes = await Db.RegistrosPacientes
                .Where(p => p.MedicoId == medico.Id)
                .ToListAsync();

            var idsPacientes = pacientes
                .Select(p => p.Id)
                .ToList();

            // Buscar las consultas del médico y las de sus pacientes.
            var consultas = await Db.RegistrosConsultas
                .Where(c => c.MedicoId == medico.Id ||
                            idsPacientes.Contains(c.PacienteId))
                .ToListAsync();

            // Eliminar primero las consultas y después los pacientes.
            Db.RegistrosConsultas.RemoveRange(consultas);
            Db.RegistrosPacientes.RemoveRange(pacientes);

            await Db.SaveChangesAsync();

            // Eliminar la cuenta del médico.
            var resultado = await UserManager.DeleteAsync(medico);

            if (!resultado.Succeeded)
            {
                await transaccion.RollbackAsync();

                MostrarError(
                    "No se pudo eliminar la cuenta: " +
                    string.Join(" | ", resultado.Errors.Select(e => e.Description)));

                CancelarEliminacion();
                return;
            }

            await transaccion.CommitAsync();

            CancelarEliminacion();
            await CargarMedicos();

            Mensaje = "La cuenta del médico y sus registros asociados se eliminaron correctamente.";
            ClaseMensaje = "alert-success";
        }
        catch (Exception)
        {
            await transaccion.RollbackAsync();

            CancelarEliminacion();

            MostrarError(
                "Ocurrió un error al eliminar la cuenta y sus registros. " +
                "Verifica la base de datos e inténtalo nuevamente.");
        }
    }

    

    private void MostrarError(string mensaje)
    {
        Mensaje = mensaje;
        ClaseMensaje = "alert-danger";
    }
}
