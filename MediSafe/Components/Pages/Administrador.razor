@page "/administrador"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

@using MediSafe.Data
@using MediSafe.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<PageTitle>Panel de administración - MediSafe</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Panel de administración</h1>
            <p class="text-muted mb-0">
                Desde aquí puedes administrar las cuentas de los médicos.
            </p>
        </div>

        <form method="post" action="/logout">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-outline-danger">
                Cerrar sesión
            </button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @ClaseMensaje" role="alert">
            @Mensaje
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-3">Registrar médico</h4>

                    <EditForm Model="NuevoMedico"
                              OnValidSubmit="CrearMedico"
                              FormName="RegistrarMedico">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre completo</label>
                            <InputText class="form-control"
                                       @bind-Value="NuevoMedico.Nombre" />
                            <ValidationMessage For="@(() => NuevoMedico.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <InputText type="email" class="form-control"
                                       @bind-Value="NuevoMedico.Email" />
                            <ValidationMessage For="@(() => NuevoMedico.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Contraseña inicial</label>
                            <InputText type="password" class="form-control"
                                       @bind-Value="NuevoMedico.Password" />
                            <ValidationMessage For="@(() => NuevoMedico.Password)" />
                            <small class="text-muted">
                                La contraseña debe cumplir las reglas de seguridad de MediSafe.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Crear cuenta médica
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Seguridad</h4>
                    <p>
                        Las cuentas se crean con el rol médico.
                        Las contraseñas son gestionadas por ASP.NET Core Identity.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-4 mb-5">
        <div class="card-body">
            <h4 class="card-title mb-3">Médicos registrados</h4>

            @if (Medicos.Count == 0)
            {
                <p class="text-muted">
                    Todavía no hay médicos registrados.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo electrónico</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var medico in Medicos)
                            {
                                <tr>
                                    <td>@medico.Nombre</td>
                                    <td>@medico.Email</td>
                                    <td>
                                        <button class="btn btn-warning btn-sm me-2"
                                                @onclick="() => IniciarEdicion(medico)">
                                            Editar
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                @onclick="() => SolicitarEliminacion(medico)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (MedicoEditando != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4>Editar médico</h4>

                <EditForm Model="MedicoEditando"
                          OnValidSubmit="GuardarEdicion"
                          FormName="EditarMedico">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre completo</label>
                        <InputText class="form-control"
                                   @bind-Value="MedicoEditando.Nombre" />
                        <ValidationMessage For="@(() => MedicoEditando.Nombre)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <InputText type="email" class="form-control"
                                   @bind-Value="MedicoEditando.Email" />
                        <ValidationMessage For="@(() => MedicoEditando.Email)" />
                    </div>

                    <button type="submit" class="btn btn-success me-2">
                        Guardar cambios
                    </button>

                    <button type="button" class="btn btn-secondary"
                            @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                </EditForm>
            </div>
        </div>
    }

    @if (MedicoPorEliminar != null)
    {
        <div class="alert alert-warning">
            <p>
                ¿Seguro que deseas eliminar la cuenta de
                <strong>@MedicoPorEliminar.Nombre</strong>
                (@MedicoPorEliminar.Email)?
            </p>

            <button class="btn btn-danger me-2"
                    @onclick="EliminarMedico">
                Sí, eliminar cuenta
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelarEliminacion">
                Cancelar
            </button>
        </div>
    }
</div>

@code {
    private CrearMedicoModel NuevoMedico = new();

    private List<ApplicationUser> Medicos = new();

    private ApplicationUser? MedicoEditando;
    private ApplicationUser? MedicoPorEliminar;

    private string Mensaje = string.Empty;
    private string ClaseMensaje = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await CargarMedicos();
    }

    private async Task CargarMedicos()
    {
        var usuariosMedicos = await UserManager.GetUsersInRoleAsync(
            ApplicationRoles.Doctor);

        Medicos = usuariosMedicos
            .OrderBy(m => m.Nombre)
            .ToList();
    }

    private async Task CrearMedico()
    {
        var email = NuevoMedico.Email.Trim();

        var existente = await UserManager.FindByEmailAsync(email);

        if (existente != null)
        {
            MostrarError("Ya existe una cuenta con ese correo electrónico.");
            return;
        }

        var medico = new ApplicationUser
        {
            UserName = email,
            Email = email,
            Nombre = NuevoMedico.Nombre.Trim(),
            EmailConfirmed = true
        };

        var resultado = await UserManager.CreateAsync(
            medico, NuevoMedico.Password);

        if (!resultado.Succeeded)
        {
            MostrarError("Error al crear el usuario: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));
            return;
        }

        var resultadoRol = await UserManager.AddToRoleAsync(
            medico, ApplicationRoles.Doctor);

        if (!resultadoRol.Succeeded)
        {
            await UserManager.DeleteAsync(medico);
            MostrarError("Error al asignar el rol: " +
                string.Join(" | ", resultadoRol.Errors.Select(e => e.Description)));
            return;
        }

        NuevoMedico = new CrearMedicoModel();
        await CargarMedicos();

        Mensaje = "La cuenta del médico se creó correctamente.";
        ClaseMensaje = "alert-success";
    }

    private void IniciarEdicion(ApplicationUser medico)
    {
        MedicoEditando = new ApplicationUser
        {
            Id = medico.Id,
            Nombre = medico.Nombre,
            Email = medico.Email,
            UserName = medico.UserName,
            EmailConfirmed = medico.EmailConfirmed
        };

        MedicoPorEliminar = null;
        Mensaje = string.Empty;
    }

    private async Task GuardarEdicion()
    {
        if (MedicoEditando == null)
            return;

        var original = await UserManager.FindByIdAsync(MedicoEditando.Id);

        if (original == null ||
            !await UserManager.IsInRoleAsync(original, ApplicationRoles.Doctor))
        {
            MostrarError("No se encontró la cuenta médica.");
            return;
        }

        var email = MedicoEditando.Email?.Trim();

        if (string.IsNullOrWhiteSpace(email))
        {
            MostrarError("El correo electrónico es obligatorio.");
            return;
        }

        var usuarioConCorreo = await UserManager.FindByEmailAsync(email);

        if (usuarioConCorreo != null && usuarioConCorreo.Id != original.Id)
        {
            MostrarError("Ese correo ya está registrado en otra cuenta.");
            return;
        }

        original.Nombre = MedicoEditando.Nombre.Trim();
        original.Email = email;
        original.UserName = email;
        original.NormalizedEmail = UserManager.NormalizeEmail(email);
        original.NormalizedUserName = UserManager.NormalizeName(email);

        var resultado = await UserManager.UpdateAsync(original);

        if (!resultado.Succeeded)
        {
            MostrarError("No se pudieron guardar los cambios: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));
            return;
        }

        MedicoEditando = null;
        await CargarMedicos();

        Mensaje = "Los datos del médico se actualizaron correctamente.";
        ClaseMensaje = "alert-success";
    }

    private void CancelarEdicion()
    {
        MedicoEditando = null;
    }

    private void SolicitarEliminacion(ApplicationUser medico)
    {
        MedicoPorEliminar = medico;
        MedicoEditando = null;
        Mensaje = string.Empty;
    }

    private async Task EliminarMedico()
    {
        if (MedicoPorEliminar == null)
            return;

        var medico = await UserManager.FindByIdAsync(MedicoPorEliminar.Id);

        if (medico == null ||
            !await UserManager.IsInRoleAsync(medico, ApplicationRoles.Doctor))
        {
            MostrarError("No se encontró la cuenta médica.");
            MedicoPorEliminar = null;
            return;
        }

        var tienePacientes = await Db.RegistrosPacientes
            .AnyAsync(p => p.MedicoId == medico.Id);

        var tieneConsultas = await Db.RegistrosConsultas
            .AnyAsync(c => c.MedicoId == medico.Id);

        if (tienePacientes || tieneConsultas)
        {
            MostrarError(
                "No se puede eliminar esta cuenta porque tiene pacientes o consultas asociadas. " +
                "Conserva la información clínica y revisa su gestión antes de eliminarla.");
            MedicoPorEliminar = null;
            return;
        }

        var resultado = await UserManager.DeleteAsync(medico);

        if (!resultado.Succeeded)
        {
            MostrarError("No se pudo eliminar la cuenta: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));
            MedicoPorEliminar = null;
            return;
        }

        MedicoPorEliminar = null;
        await CargarMedicos();

        Mensaje = "La cuenta del médico se eliminó correctamente.";
        ClaseMensaje = "alert-success";
    }

    private void CancelarEliminacion()
    {
        MedicoPorEliminar = null;
    }

    private void MostrarError(string mensaje)
    {
        Mensaje = mensaje;
        ClaseMensaje = "alert-danger";
    }
}
