@page "/administrador"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

@using MediSafe.Data
@using MediSafe.Models
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

<PageTitle>Panel de administración - MediSafe</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Panel de administración</h1>
            <p class="text-muted mb-0">
                Desde aquí puedes administrar las cuentas de los médicos.
            </p>
        </div>

        <form method="post" action="/logout">
            <AntiforgeryToken />

            <button type="submit" class="btn btn-outline-danger">
                Cerrar sesión
            </button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="alert @ClaseMensaje" role="alert">
            @Mensaje
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-3">Registrar médico</h4>

                    <EditForm Model="NuevoMedico"
                              OnValidSubmit="CrearMedico"
                              FormName="RegistrarMedico">

                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label" for="nombre">
                                Nombre completo
                            </label>

                            <InputText id="nombre"
                                       class="form-control"
                                       @bind-Value="NuevoMedico.Nombre" />

                            <ValidationMessage For="@(() => NuevoMedico.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="email">
                                Correo electrónico
                            </label>

                            <InputText id="email"
                                       type="email"
                                       class="form-control"
                                       @bind-Value="NuevoMedico.Email" />

                            <ValidationMessage For="@(() => NuevoMedico.Email)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="password">
                                Contraseña inicial
                            </label>

                            <InputText id="password"
                                       type="password"
                                       class="form-control"
                                       @bind-Value="NuevoMedico.Password" />

                            <ValidationMessage For="@(() => NuevoMedico.Password)" />

                            <small class="text-muted">
                                La contraseña debe tener al menos 8 caracteres
                                y cumplir las reglas de seguridad de MediSafe.
                            </small>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Crear cuenta médica
                        </button>

                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">Seguridad</h4>

                    <p>
                        Las cuentas se crean con el rol médico.
                        Las contraseñas son gestionadas por
                        ASP.NET Core Identity.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CrearMedicoModel NuevoMedico = new();

    private string Mensaje = string.Empty;

    private string ClaseMensaje = "alert-info";

    private async Task CrearMedico()
    {
        Mensaje = "Iniciando registro...";
        ClaseMensaje = "alert-info";

        Console.WriteLine("MEDISAFE: se ejecutó CrearMedico");

        var email = NuevoMedico.Email.Trim();

        var existente = await UserManager.FindByEmailAsync(email);

        if (existente != null)
        {
            MostrarError("Ya existe una cuenta con ese correo electrónico.");
            return;
        }

        var medico = new ApplicationUser
        {
            UserName = email,
            Email = email,
            Nombre = NuevoMedico.Nombre.Trim(),
            EmailConfirmed = true
        };

        var resultado = await UserManager.CreateAsync(
            medico,
            NuevoMedico.Password);

        if (!resultado.Succeeded)
        {
            MostrarError(
                "Error al crear el usuario: " +
                string.Join(" | ", resultado.Errors.Select(e => e.Description)));

            return;
        }

        var resultadoRol = await UserManager.AddToRoleAsync(
            medico,
            ApplicationRoles.Doctor);

        if (!resultadoRol.Succeeded)
        {
            await UserManager.DeleteAsync(medico);

            MostrarError(
                "Error al asignar el rol: " +
                string.Join(" | ", resultadoRol.Errors.Select(e => e.Description)));

            return;
        }

        NuevoMedico = new CrearMedicoModel();

        Mensaje = "La cuenta del médico se creó correctamente.";
        ClaseMensaje = "alert-success";
    }

    private void MostrarError(string mensaje)
    {
        Mensaje = mensaje;
        ClaseMensaje = "alert-danger";
    }
}
